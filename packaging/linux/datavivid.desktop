[Desktop Entry]
Type=Application
Version=1.5
Name=DataVivid
GenericName=Data Viewer
Comment=View, clean and convert CSV, Parquet, Excel, JSON, Arrow, Avro and SQLite data
Exec=datavivid %f
TryExec=datavivid
Icon=datavivid
Terminal=false
StartupNotify=true
StartupWMClass=datavivid
Categories=Office;Spreadsheet;Database;
Keywords=csv;parquet;excel;json;arrow;avro;sqlite;dataframe;table;
MimeType=text/csv;text/tab-separated-values;application/vnd.apache.parquet;application/json;application/x-ndjson;application/vnd.apache.arrow.file;application/vnd.apache.avro;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.ms-excel.sheet.macroEnabled.12;application/vnd.ms-excel.sheet.binary.macroEnabled.12;application/vnd.ms-excel;application/vnd.oasis.opendocument.spreadsheet;application/vnd.sqlite3;application/x-sqlite3;
